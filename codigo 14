/**
 * Últimos alunos cadastrados
 */
function ultimosAlunos(limite) {

  limite = limite || 5;

  const lista = listarAlunos();

  return lista.slice(-limite).reverse();

}

/**
 * Últimas ocorrências
 */
function ultimasOcorrencias(limite) {

  limite = limite || 5;

  const lista = listarOcorrencias();

  return lista.slice(-limite).reverse();

}

/**
 * Últimas atividades
 */
function ultimasAtividades(limite) {

  limite = limite || 5;

  const lista = listarAtividades();

  return lista.slice(-limite).reverse();

}

/**
 * Indicadores rápidos
 */
function indicadoresRapidos() {

  return {

    mediaTurmas: Number(
      (
        totalAlunos() /
        Math.max(totalTurmas(),1)
      ).toFixed(1)
    ),

    mediaNotas: calcularMediaGeral(),

    totalUsuarios: contar(ABAS.USUARIOS),

    dataAtualizacao: Utilities.formatDate(

      new Date(),

      Session.getScriptTimeZone(),

      "dd/MM/yyyy HH:mm:ss"

    )

  };

}

/**
 * Média geral das notas
 */
function calcularMediaGeral() {

  const lista = listarNotas();

  if(lista.length==0){

    return 0;

  }

  let soma = 0;

  lista.forEach(function(item){

    soma += Number(item.Media);

  });

  return Number((soma/lista.length).toFixed(2));

}
