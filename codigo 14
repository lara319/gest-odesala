/**
 * Dashboard principal
 */
function dashboardPrincipal() {

  return {

    sistema: NOME_SISTEMA,

    versao: VERSAO,

    dataAtual: Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "dd/MM/yyyy HH:mm"
    ),

    usuario: getUsuarioLogado(),

    cards: obterCards(),

    graficos: obterGraficos()

  };

}

/**
 * Cards do Dashboard
 */
function obterCards() {

  return {

    alunos: totalAlunos(),

    professores: totalProfessores(),

    turmas: totalTurmas(),

    disciplinas: totalDisciplinas(),

    atividades: estatisticasAtividades().total,

    ocorrencias: estatisticasOcorrencias().total,

    notas: listarNotas().length,

    frequencias: listarFrequencias().length

  };

}

/**
 * Dados para gráficos
 */
function obterGraficos() {

  return {

    alunosPorTurma: graficoAlunosPorTurma(),

    notas: graficoNotas(),

    frequencia: graficoFrequencia(),

    ocorrencias: graficoOcorrencias(),

    atividades: graficoAtividades()

  };

}

/**
 * Gráfico de alunos por turma
 */
function graficoAlunosPorTurma() {

  const dados = totalPorTurma();

  let categorias = [];

  let valores = [];

  Object.keys(dados).forEach(function(turma){

    categorias.push(turma);

    valores.push(dados[turma]);

  });

  return {

    categorias: categorias,

    valores: valores

  };

}

/**
 * Gráfico de notas
 */
function graficoNotas() {

  const est = estatisticasNotas();

  return {

    categorias: [

      "Aprovados",

      "Recuperação",

      "Reprovados"

    ],

    valores: [

      est.aprovados,

      est.recuperacao,

      est.reprovados

    ]

  };

}

