<script>

/* =========================================================
   VARIÁVEIS GLOBAIS
========================================================= */

let paginaAtual = 'dashboard';
let dadosDashboard = {};
let listaAlunos = [];
let listaProfessores = [];
let listaTurmas = [];
let listaDisciplinas = [];
let listaFrequencia = [];
let listaNotas = [];
let listaAtividades = [];
let listaOcorrencias = [];
let listaUsuarios = [];

let tipoModalAtual = null;
let idEdicaoAtual = null;


/* =========================================================
   INICIALIZAÇÃO
========================================================= */

document.addEventListener('DOMContentLoaded', function () {

  verificarSessao();

});


/* =========================================================
   VERIFICAR SESSÃO
========================================================= */

function verificarSessao() {

  mostrarLoading(true);

  google.script.run
    .withSuccessHandler(function (usuario) {

      mostrarLoading(false);

      if (usuario) {

        iniciarSistema(usuario);

      } else {

        mostrarLogin();

      }

    })
    .withFailureHandler(function (erro) {

      mostrarLoading(false);

      mostrarLogin();

      console.error(erro);

    })
    .getUsuarioLogado();

}


/* =========================================================
   LOGIN
========================================================= */

function realizarLogin(event) {

  event.preventDefault();

  const email =
    document.getElementById('loginEmail').value.trim();

  const senha =
    document.getElementById('loginSenha').value;

  const mensagem =
    document.getElementById('loginMensagem');

  if (!email || !senha) {

    mensagem.textContent =
      'Informe o e-mail e a senha.';

    return;

  }

  mensagem.textContent = 'Entrando...';

  mostrarLoading(true);

  google.script.run
    .withSuccessHandler(function (resultado) {

      mostrarLoading(false);

      if (resultado && resultado.sucesso) {

        mensagem.textContent = '';

        iniciarSistema(resultado.usuario);

      } else {

        mensagem.textContent =
          resultado?.mensagem ||
          'E-mail ou senha inválidos.';

      }

    })
    .withFailureHandler(function (erro) {

      mostrarLoading(false);

      mensagem.textContent =
        'Erro ao realizar login.';

      console.error(erro);

    })
    .login(email, senha);

}


/* =========================================================
   INICIAR SISTEMA
========================================================= */

function iniciarSistema(usuario) {

  document.getElementById('loginPage').style.display =
    'none';

  document.getElementById('app').style.display =
    'flex';

  atualizarUsuario(usuario);

  atualizarData();

  abrirPagina('dashboard');

  carregarDashboard();

}


/* =========================================================
   MOSTRAR LOGIN
========================================================= */

function mostrarLogin() {

  document.getElementById('loginPage').style.display =
    'flex';

  document.getElementById('app').style.display =
    'none';

}


/* =========================================================
   USUÁRIO
========================================================= */

function atualizarUsuario(usuario) {

  if (!usuario) return;

  const nome =
    usuario.nome ||
    usuario.Nome ||
    usuario.email ||
    usuario.Email ||
    'Usuário';

  const perfil =
    usuario.perfil ||
    usuario.Perfil ||
    'Usuário';

  const elementoNome =
    document.getElementById('usuarioNome');

  const elementoPerfil =
    document.getElementById('usuarioPerfil');

  if (elementoNome) {

    elementoNome.textContent = nome;

  }

  if (elementoPerfil) {

    elementoPerfil.textContent = perfil;

  }

}


/* =========================================================
   SAIR
========================================================= */

function sairSistema() {

  if (!confirm('Deseja realmente sair do sistema?')) {

    return;

  }

  mostrarLoading(true);

  google.script.run
    .withSuccessHandler(function () {

      mostrarLoading(false);

      mostrarLogin();

    })
    .withFailureHandler(function (erro) {

      mostrarLoading(false);

      console.error(erro);

      mostrarToast(
        'Erro ao sair do sistema.',
        'error'
      );

    })
    .logout();

}


/* =========================================================
   NAVEGAÇÃO
========================================================= */

function abrirPagina(nome, botao) {

  paginaAtual = nome;

  document
    .querySelectorAll('.page')
    .forEach(function (pagina) {

      pagina.classList.remove('active-page');

    });


  const pagina =
    document.getElementById(
      'pagina-' + nome
    );

  if (pagina) {

    pagina.classList.add('active-page');

  }


  document
    .querySelectorAll('.menu-item')
    .forEach(function (item) {

      item.classList.remove('active');

    });


  if (botao) {

    botao.classList.add('active');

  } else {

    document
      .querySelectorAll('.menu-item')
      .forEach(function (item) {

        const texto =
          item.textContent
            .trim()
            .toLowerCase();

        if (
          texto === obterNomePagina(nome)
        ) {

          item.classList.add('active');

        }

      });

  }


  atualizarTituloPagina(nome);

  carregarPagina(nome);

  fecharSidebarMobile();

}


function obterNomePagina(nome) {

  const nomes = {

    dashboard: 'dashboard',

    alunos: 'alunos',

    professores: 'professores',

    turmas: 'turmas',

    disciplinas: 'disciplinas',

    frequencia: 'frequência',

    notas: 'notas',

    atividades: 'atividades',

    ocorrencias: 'ocorrências',

    usuarios: 'usuários',

    relatorios: 'relatórios'

  };

  return nomes[nome] || nome;

}


/* =========================================================
   TÍTULO DA PÁGINA
========================================================= */

function atualizarTituloPagina(nome) {

  const dados = {

    dashboard: [
      'Dashboard',
      'Visão geral da sala escolar'
    ],

    alunos: [
      'Alunos',
      'Gerencie os alunos cadastrados.'
    ],

    professores: [
      'Professores',
      'Gerencie os professores.'
    ],

    turmas: [
      'Turmas',
      'Gerencie as turmas escolares.'
    ],

    disciplinas: [
      'Disciplinas',
      'Gerencie as disciplinas.'
    ],

    frequencia: [
      'Frequência',
      'Controle de presença dos alunos.'
    ],

    notas: [
      'Notas',
      'Gerencie as notas e boletins.'
    ],

    atividades: [
      'Atividades',
      'Gerencie atividades e trabalhos.'
    ],

    ocorrencias: [
      'Ocorrências',
      'Histórico de ocorrências dos alunos.'
    ],

    usuarios: [
      'Usuários',
      'Controle de acesso ao sistema.'
    ],

    relatorios: [
      'Relatórios',
      'Gere relatórios do sistema.'
    ]

  };

  const info = dados[nome];

  if (!info) return;

  document.getElementById('pageTitle').textContent =
    info[0];

  document.getElementById('pageSubtitle').textContent =
    info[1];

}


/* =========================================================
   CARREGAR PÁGINA
========================================================= */

function carregarPagina(nome) {

  switch (nome) {

    case 'dashboard':
      carregarDashboard();
      break;

    case 'alunos':
      carregarAlunos();
      break;

    case 'professores':
      carregarProfessores();
      break;

    case 'turmas':
      carregarTurmas();
      break;

    case 'disciplinas':
      carregarDisciplinas();
      break;

    case 'frequencia':
      carregarFrequencia();
      break;

    case 'notas':
      carregarNotas();
      break;

    case 'atividades':
      carregarAtividades();
      break;

    case 'ocorrencias':
      carregarOcorrencias();
      break;

    case 'usuarios':
      carregarUsuarios();
      break;

  }

}


/* =========================================================
   DASHBOARD
========================================================= */

function carregarDashboard() {

  google.script.run
    .withSuccessHandler(function (dados) {

      if (!dados) return;

      dadosDashboard = dados;

      preencherDashboard(dados);

    })
    .withFailureHandler(function (erro) {

      console.error(erro);

      mostrarToast(
        'Erro ao carregar dashboard.',
        'error'
      );

    })
    .dashboardPrincipal();

}


function preencherDashboard(dados) {

  const cards =
    dados.cards || {};

  preencherTexto(
    'cardAlunos',
    cards.alunos || 0
  );

  preencherTexto(
    'cardProfessores',
    cards.professores || 0
  );

  preencherTexto(
    'cardTurmas',
    cards.turmas || 0
  );

  preencherTexto(
    'cardDisciplinas',
    cards.disciplinas || 0
  );

  preencherTexto(
    'cardNotas',
    cards.notas || 0
  );

  preencherTexto(
    'cardFrequencias',
    cards.frequencias || 0
  );

  preencherTexto(
    'cardAtividades',
    cards.atividades || 0
  );

  preencherTexto(
    'cardOcorrencias',
    cards.ocorrencias || 0
  );


  const graficos =
    dados.graficos || {};

  criarGraficoSimples(
    'graficoNotas',
    graficos.notas
  );

  criarGraficoSimples(
    'graficoFrequencia',
    graficos.frequencia
  );

  criarGraficoSimples(
    'graficoAtividades',
    graficos.atividades
  );

  criarGraficoSimples(
    'graficoOcorrencias',
    graficos.ocorrencias
  );

}


/* =========================================================
   GRÁFICO SIMPLES
========================================================= */

function criarGraficoSimples(elementoId, dados) {

  const elemento =
    document.getElementById(elementoId);

  if (!elemento) return;

  if (
    !dados ||
    !dados.categorias ||
    !dados.valores ||
    dados.categorias.length === 0
  ) {

    elemento.innerHTML =
      '<div class="empty-chart">Sem dados disponíveis.</div>';

    return;

  }


  const maior =
    Math.max(...dados.valores, 1);


  let html = '<div style="display:flex;flex-direction:column;gap:13px;">';


  dados.categorias.forEach(function (categoria, index) {

    const valor =
      Number(dados.valores[index]) || 0;

    const porcentagem =
      Math.max(
        3,
        Math.round((valor / maior) * 100)
      );


    html += `

      <div>

        <div style="
          display:flex;
          justify-content:space-between;
          margin-bottom:5px;
          font-size:12px;
        ">

          <span>${escaparHTML(categoria)}</span>

          <strong>${valor}</strong>

        </div>

        <div style="
          height:8px;
          background:#e2e8f0;
          border-radius:20px;
          overflow:hidden;
        ">

          <div style="
            width:${porcentagem}%;
            height:100%;
            background:#2563eb;
            border-radius:20px;
            transition:width .5s;
          "></div>

        </div>

      </div>

    `;

  });


  html += '</div>';

  elemento.innerHTML = html;

}


/* =========================================================
   ALUNOS
========================================================= */

function carregarAlunos() {

  const tabela =
    document.getElementById('tabelaAlunos');

  tabela.innerHTML =
    '<tr><td colspan="7">Carregando...</td></tr>';


  google.script.run
    .withSuccessHandler(function (dados) {

      listaAlunos = dados || [];

      renderizarAlunos(listaAlunos);

    })
    .withFailureHandler(function (erro) {

      tabela.innerHTML =
        '<tr><td colspan="7">Erro ao carregar alunos.</td></tr>';

      console.error(erro);

    })
    .listarAlunos();

}


function renderizarAlunos(lista) {

  const tabela =
    document.getElementById('tabelaAlunos');

  if (!lista.length) {

    tabela.innerHTML =
      '<tr><td colspan="7" class="empty-state">Nenhum aluno encontrado.</td></tr>';

    return;

  }


  tabela.innerHTML = lista.map(function (aluno) {

    return `

      <tr>

        <td>${escaparHTML(aluno.ID)}</td>

        <td>${escaparHTML(aluno.Nome)}</td>

        <td>${escaparHTML(aluno.RA)}</td>

        <td>${escaparHTML(aluno.Turma)}</td>

        <td>${escaparHTML(aluno.Serie)}</td>

        <td>
          ${criarBadge(
            aluno.Status || 'ATIVO'
          )}
        </td>

        <td>

          <div class="table-actions">

            <button
              class="action-button action-edit"
              onclick="editarAluno('${aluno.ID}')"
              title="Editar"
            >
              ✏️
            </button>

            <button
              class="action-button action-delete"
              onclick="excluirAluno('${aluno.ID}')"
              title="Excluir"
            >
              🗑️
            </button>

          </div>

        </td>

      </tr>

    `;

  }).join('');

}


function pesquisarAlunos() {

  const texto =
    document
      .getElementById('pesquisaAlunos')
      .value
      .toLowerCase()
      .trim();

  const filtrados =
    listaAlunos.filter(function (aluno) {

      return JSON.stringify(aluno)
        .toLowerCase()
        .includes(texto);

    });

  renderizarAlunos(filtrados);

}


/* =========================================================
   MODAL ALUNO
========================================================= */

function abrirModalAluno(aluno = null) {

  tipoModalAtual = 'aluno';

  idEdicaoAtual =
    aluno ? aluno.ID : null;

  document.getElementById('modalTitulo').textContent =
    aluno ? 'Editar aluno' : 'Novo aluno';


  document.getElementById('modalConteudo').innerHTML = `

    <form id="formAluno" class="modal-form">

      <div class="form-group">

        <label>Nome</label>

        <input
          type="text"
          id="alunoNome"
          value="${escaparAtributo(aluno?.Nome || '')}"
          required
        >

      </div>

      <div class="form-group">

        <label>RA</label>

        <input
          type="text"
          id="alunoRA"
          value="${escaparAtributo(aluno?.RA || '')}"
          required
        >

      </div>

      <div class="form-group">

        <label>Turma</label>

        <input
          type="text"
          id="alunoTurma"
          value="${escaparAtributo(aluno?.Turma || '')}"
          required
        >

      </div>

      <div class="form-group">

        <label>Série</label>

        <input
          type="text"
          id="alunoSerie"
          value="${escaparAtributo(aluno?.Serie || '')}"
          required
        >

      </div>

    </form>

  `;

  abrirModal();

}


function salvarAluno() {

  const dados = {

    nome:
      document.getElementById('alunoNome').value.trim(),

    ra:
      document.getElementById('alunoRA').value.trim(),

    turma:
      document.getElementById('alunoTurma').value.trim(),

    serie:
      document.getElementById('alunoSerie').value.trim()

  };


  if (!dados.nome || !dados.ra) {

    mostrarToast(
      'Preencha os campos obrigatórios.',
      'error'
    );

    return;

  }


  mostrarLoading(true);


  if (idEdicaoAtual) {

    google.script.run
      .withSuccessHandler(finalizarOperacao)
      .withFailureHandler(tratarErro)
      .atualizarAluno(
        idEdicaoAtual,
        dados
      );

  } else {

    google.script.run
      .withSuccessHandler(finalizarOperacao)
      .withFailureHandler(tratarErro)
      .cadastrarAluno(dados);

  }

}


function editarAluno(id) {

  const aluno =
    listaAlunos.find(function (item) {

      return String(item.ID) === String(id);

    });

  if (aluno) {

    abrirModalAluno(aluno);

  }

}


function excluirAluno(id) {

  if (
    !confirm(
      'Deseja excluir este aluno?'
    )
  ) return;


  mostrarLoading(true);

  google.script.run
    .withSuccessHandler(finalizarOperacao)
    .withFailureHandler(tratarErro)
    .excluirAluno(id);

}


/* =========================================================
   PROFESSORES
========================================================= */

function carregarProfessores() {

  const tabela =
    document.getElementById(
      'tabelaProfessores'
    );

  tabela.innerHTML =
    '<tr><td colspan="7">Carregando...</td></tr>';


  google.script.run
    .withSuccessHandler(function (dados) {

      listaProfessores = dados || [];

      renderizarProfessores(
        listaProfessores
      );

    })
    .withFailureHandler(function (erro) {

      tabela.innerHTML =
        '<tr><td colspan="7">Erro ao carregar professores.</td></tr>';

      console.error(erro);

    })
    .listarProfessores();

}


function renderizarProfessores(lista) {

  const tabela =
    document.getElementById(
      'tabelaProfessores'
    );

  if (!lista.length) {

    tabela.innerHTML =
      '<tr><td colspan="7" class="empty-state">Nenhum professor encontrado.</td></tr>';

    return;

  }


  tabela.innerHTML = lista.map(function (item) {

    return `

      <tr>

        <td>${escaparHTML(item.ID)}</td>

        <td>${escaparHTML(item.Nome)}</td>

        <td>${escaparHTML(item.Materia)}</td>

        <td>${escaparHTML(item.Email || '')}</td>

        <td>${escaparHTML(item.Telefone || '')}</td>

        <td>${criarBadge(item.Status || 'ATIVO')}</td>

        <td>

          <div class="table-actions">

            <button
              class="action-button action-edit"
              onclick="editarProfessor('${item.ID}')"
            >
              ✏️
            </button>

            <button
              class="action-button action-delete"
              onclick="excluirProfessor('${item.ID}')"
            >
              🗑️
            </button>

          </div>

        </td>

      </tr>

    `;

  }).join('');

}


function pesquisarProfessores() {

  const texto =
    document
      .getElementById('pesquisaProfessores')
      .value
      .toLowerCase()
      .trim();

  const filtrados =
    listaProfessores.filter(function (item) {

      return JSON.stringify(item)
        .toLowerCase()
        .includes(texto);

    });

  renderizarProfessores(filtrados);

}


function abrirModalProfessor(professor = null) {

  tipoModalAtual = 'professor';

  idEdicaoAtual =
    professor ? professor.ID : null;


  document.getElementById('modalTitulo').textContent =
    professor
      ? 'Editar professor'
      : 'Novo professor';


  document.getElementById('modalConteudo').innerHTML = `

    <form id="formProfessor" class="modal-form">

      <div class="form-group">

        <label>Nome</label>

        <input
          type="text"
          id="professorNome"
          value="${escaparAtributo(professor?.Nome || '')}"
          required
        >

      </div>

      <div class="form-group">

        <label>Disciplina</label>

        <input
          type="text"
          id="professorMateria"
          value="${escaparAtributo(professor?.Materia || '')}"
        >

      </div>

      <div class="form-group">

        <label>E-mail</label>

        <input
          type="email"
          id="professorEmail"
          value="${escaparAtributo(professor?.Email || '')}"
        >

      </div>

      <div class="form-group">

        <label>Telefone</label>

        <input
          type="text"
          id="professorTelefone"
          value="${escaparAtributo(professor?.Telefone || '')}"
        >

      </div>

    </form>

  `;

  abrirModal();

}


function salvarProfessor() {

  const dados = {

    nome:
      document.getElementById(
        'professorNome'
      ).value.trim(),

    materia:
      document.getElementById(
        'professorMateria'
      ).value.trim(),

    email:
      document.getElementById(
        'professorEmail'
      ).value.trim(),

    telefone:
      document.getElementById(
        'professorTelefone'
      ).value.trim()

  };


  mostrarLoading(true);


  if (idEdicaoAtual) {

    google.script.run
      .withSuccessHandler(finalizarOperacao)
      .withFailureHandler(tratarErro)
      .atualizarProfessor(
        idEdicaoAtual,
        dados
      );

  } else {

    google.script.run
      .withSuccessHandler(finalizarOperacao)
      .withFailureHandler(tratarErro)
      .cadastrarProfessor(dados);

  }

}


function editarProfessor(id) {

  const professor =
    listaProfessores.find(function (item) {

      return String(item.ID) === String(id);

    });

  if (professor) {

    abrirModalProfessor(professor);

  }

}


function excluirProfessor(id) {

  if (
    !confirm(
      'Deseja excluir este professor?'
    )
  ) return;


  mostrarLoading(true);

  google.script.run
    .withSuccessHandler(finalizarOperacao)
    .withFailureHandler(tratarErro)
    .excluirProfessor(id);

}


/* =========================================================
   TURMAS
========================================================= */

function carregarTurmas() {

  const tabela =
    document.getElementById('tabelaTurmas');

  tabela.innerHTML =
    '<tr><td colspan="8">Carregando...</td></tr>';


  google.script.run
    .withSuccessHandler(function (dados) {

      listaTurmas = dados || [];

      renderizarTurmas(listaTurmas);

    })
    .withFailureHandler(tratarErro)
    .listarTurmas();

}


function renderizarTurmas(lista) {

  const tabela =
    document.getElementById(
      'tabelaTurmas'
    );

  if (!lista.length) {

    tabela.innerHTML =
      '<tr><td colspan="8" class="empty-state">Nenhuma turma encontrada.</td></tr>';

    return;

  }


  tabela.innerHTML = lista.map(function (item) {

    return `

      <tr>

        <td>${escaparHTML(item.ID)}</td>

        <td>${escaparHTML(item.Nome || item.Turma)}</td>

        <td>${escaparHTML(item.Serie || '')}</td>

        <td>${escaparHTML(item.Ano || '')}</td>

        <td>${escaparHTML(item.Professor || '')}</td>

        <td>${escaparHTML(item.Turno || '')}</td>

        <td>${escaparHTML(item.Sala || '')}</td>

        <td>

          <div class="table-actions">

            <button
              class="action-button action-edit"
              onclick="editarTurma('${item.ID}')"
            >
              ✏️
            </button>

            <button
              class="action-button action-delete"
              onclick="excluirTurma('${item.ID}')"
            >
              🗑️
            </button>

          </div>

        </td>

      </tr>

    `;

  }).join('');

}


function abrirModalTurma(turma = null) {

  tipoModalAtual = 'turma';

  idEdicaoAtual =
    turma ? turma.ID : null;


  document.getElementById('modalTitulo').textContent =
    turma ? 'Editar turma' : 'Nova turma';


  document.getElementById('modalConteudo').innerHTML = `

    <form class="modal-form">

      <div class="form-group">

        <label>Nome da turma</label>

        <input
          id="turmaNome"
          value="${escaparAtributo(turma?.Nome || turma?.Turma || '')}"
          required
        >

      </div>

      <div class="form-group">

        <label>Série</label>

        <input
          id="turmaSerie"
          value="${escaparAtributo(turma?.Serie || '')}"
        >

      </div>

      <div class="form-group">

        <label>Ano</label>

        <input
          id="turmaAno"
          type="number"
          value="${escaparAtributo(turma?.Ano || new Date().getFullYear())}"
